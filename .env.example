# ============ PostgreSQL ============
POSTGRES_USER=storyclaw
POSTGRES_PASSWORD=storyclaw_dev_pwd
POSTGRES_DB=storyclaw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://storyclaw:storyclaw_dev_pwd@postgres:5432/storyclaw

# ============ Milvus ============
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ============ Neo4j ============
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=storyclaw_neo4j_pwd

# ============ MinIO ============
MINIO_ACCESS_KEY=storyclaw
MINIO_SECRET_KEY=storyclaw_minio_pwd
MINIO_BUCKET=storyclaw

# ============ LangGraph Server ============
LANGGRAPH_URL=http://langgraph-server:8000
LANGGRAPH_DB_URI=postgresql://storyclaw:storyclaw_dev_pwd@postgres:5432/storyclaw_langgraph

# ============ Auth ============
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ============ Backend ============
# Docker 宿主机端口；容器内 backend:8000 / frontend:5173 保持不变
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174

# ============ LLM defaults ============
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=8192

# ============ Embedding ============
EMBEDDING_MODEL=bge-base-zh

# ============ 平台管理 ============
# 默认禁用模拟购买；真实支付尚未接入
MOCK_PAYMENTS_ENABLED=false
# 知识库失败时不将临时内存当作持久化存储
RAG_ALLOW_MEMORY_FALLBACK=false
# 必须与平台 Embedding 实际输出维度一致
MILVUS_VECTOR_DIM=1024

# 独立运营中台
ADMIN_HOST_PORT=5174
ADMIN_PUBLIC_URL=http://localhost:5174
WRITER_PUBLIC_URL=http://localhost:5173

# 后台具体任务并发：不同用户并行，同一本书仍串行
# auto按当前容器可见CPU/内存估算本实例容量；正整数可显式覆盖
WORKER_JOB_CONCURRENCY=auto
# 0不额外限制集群总Job数；按供应商实际额度可显式设置
WORKER_GLOBAL_JOB_CONCURRENCY=0
WORKER_USER_CONCURRENCY=1
WORKER_POLL_SECONDS=0.5
